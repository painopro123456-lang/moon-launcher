<Application x:Class="MoonLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="NativeStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="PageBrush" Color="#F3F6FB"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#6C83D7"/>
      <SolidColorBrush x:Key="TextBrush" Color="#202B40"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#738198"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>