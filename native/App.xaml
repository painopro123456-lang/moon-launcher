<Application x:Class="MoonLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="NativeStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="PageBrush" Color="#060B16"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#0B192B"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#79D2FF"/>
      <SolidColorBrush x:Key="TextBrush" Color="#F0F7FF"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#A4B9D2"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>