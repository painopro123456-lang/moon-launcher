<Application x:Class="MoonLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="NativeStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="PageBrush" Color="#070F1D"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#0D1C31"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#69C8FF"/>
      <SolidColorBrush x:Key="TextBrush" Color="#F0F7FF"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#9CB3CF"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>