<Window x:Class="MoonLauncher.MainWindow" Icon="pack://application:,,,/moon-icon.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moon Launcher" Height="720" Width="1120" MinHeight="600" MinWidth="900" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#09172A" CornerRadius="18" Padding="18" Margin="0,0,18,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="☾  MOON" FontSize="23" FontWeight="Bold" Foreground="#8BD9FF" Margin="0,4,0,4"/>
          <TextBlock Text="NATIVE WINDOWS EDITION" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,28"/>
          <Button Content="Overview" Click="Overview_Click" Style="{StaticResource NavButton}"/>
          <Button Content="Minecraft versions" Click="Versions_Click" Style="{StaticResource NavButton}"/>
          <Button Content="Installed Instances" Click="Instances_Click" Style="{StaticResource NavButton}"/>
          <Button Content="Settings" Click="Settings_Click" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Electron-free build" Foreground="#75D7B2" FontSize="11" Margin="0,12,0,0"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,2,0,20">
        <TextBlock x:Name="PageTitle" Text="Welcome to Moon Launcher" FontSize="28" FontWeight="Bold"/>
        <TextBlock x:Name="PageSubtitle" Text="A lightweight native Windows shell for Minecraft Java Edition." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <ScrollViewer x:Name="HomeContent" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="#102947" BorderBrush="#285782" BorderThickness="1" CornerRadius="18" Padding="26" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="BUILT FOR A CLEANER START" Foreground="#8BD9FF" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="Your Minecraft hub." FontSize="32" FontWeight="Bold" Margin="0,9,0,5"/>
              <TextBlock Text="Moon Launcher is being migrated from Electron to native WPF. This build uses the Windows desktop UI framework instead of embedding Chromium." TextWrapping="Wrap" Foreground="#C3D7EC" FontSize="13" MaxWidth="650"/>
            </StackPanel>
          </Border>
          <UniformGrid Columns="2" Margin="0,0,0,16">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="Version catalog" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="VersionCount" Text="Not loaded" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/><Button Content="Load Minecraft versions" Click="LoadVersions_Click" Margin="0,14,0,0" Padding="10,7"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="8,0,0,0">
              <StackPanel><TextBlock Text="Local instances" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="InstanceCount" Text="0 instances" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/><Button Content="Create instance" Click="CreateInstance_Click" Margin="0,14,0,0" Padding="10,7"/></StackPanel>
            </Border>
          </UniformGrid>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
            <StackPanel><TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="Ready. This is the first native migration build." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><ListBox x:Name="VersionsList" Visibility="Collapsed" Margin="0,12,0,0" MaxHeight="240" Background="#081425" Foreground="{StaticResource TextBrush}" BorderThickness="0"/></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="InstalledInstancesPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,8">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Your installed game profiles" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Modpacks you install appear here as separate instances." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            <Button Content="Refresh instances" Click="RefreshInstalledInstances_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0"/>
          </StackPanel>
          <ListBox x:Name="InstalledInstancesList" Background="#081425" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="8" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Border>
      <TextBlock Grid.Row="2" Text="MOON LAUNCHER  •  NATIVE WPF  •  WINDOWS x64" Foreground="#6D89AA" FontSize="9" Margin="0,16,0,0"/>
    </Grid>

      <!-- Retained named controls for current code-behind features that are not part of the original creation-era UI. -->
      <StackPanel Visibility="Collapsed">
        <TextBlock x:Name="AccountStatusText"/><Button x:Name="MicrosoftSignInButton"/><Button x:Name="MicrosoftSignOutButton"/>
        <StackPanel x:Name="WorkspacePanel"><TextBlock x:Name="OverviewHero"/><StackPanel x:Name="OverviewStats"/></StackPanel>
        <StackPanel x:Name="ModpacksPanel"><TextBox x:Name="ModpackQuery"/><ListBox x:Name="ModpackResults"/><Button x:Name="InstallSelectedModpackButton"/></StackPanel>
        <StackPanel x:Name="ServersPanel"><TextBox x:Name="ServerName"/><TextBox x:Name="ServerAddress"/><ListBox x:Name="ServerList"/></StackPanel>
        <StackPanel x:Name="ModsPanel"><TextBlock x:Name="ModsFolderText"/><TextBox x:Name="ModQuery"/><TextBox x:Name="ModGameVersion"/><ComboBox x:Name="ModLoaderChoice"/><ListBox x:Name="ModResults"/><TextBlock x:Name="ModInstallStatus"/></StackPanel>
        <StackPanel x:Name="SettingsPanel"><TextBox x:Name="DataDirectory"/></StackPanel>
      </StackPanel>
  </Grid>
</Window>