<Window x:Class="MoonLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moon Launcher" Height="800" Width="1280" MinHeight="680" MinWidth="1000" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0B1424" BorderBrush="#1C2A40" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,18,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="2,5,0,4"><TextBlock Text="☾" FontSize="27" Foreground="#A8DFFF" Margin="0,0,9,0"/><TextBlock Text="MOON" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="MINECRAFT LAUNCHER" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="3,0,0,32"/>
          <TextBlock Text="LIBRARY" Foreground="#6F89A8" FontSize="10" FontWeight="Bold" Margin="4,0,0,9"/>
          <Button Content="⌂   Overview" Click="Overview_Click" Style="{StaticResource NavButton}"/>
          <Button Content="◈   Minecraft versions" Click="Versions_Click" Style="{StaticResource NavButton}"/>
          <Button Content="▦   Instances" Click="Instances_Click" Style="{StaticResource NavButton}"/>
          <Button Content="▧   Modpacks" Click="Modpacks_Click" Style="{StaticResource NavButton}"/>
          <Button Content="⌘   Mods" Click="Mods_Click" Style="{StaticResource NavButton}"/>
          <Button Content="◎   Servers" Click="Servers_Click" Style="{StaticResource NavButton}"/>
          <Button Content="⚙   Settings" Click="Settings_Click" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#101F32" CornerRadius="12" Padding="12" Margin="0,20,0,0">
          <StackPanel><TextBlock Text="ACCOUNT" FontSize="9" FontWeight="Bold" Foreground="#7E9AB8"/><TextBlock Text="Microsoft sign-in not yet ported" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="11" Foreground="#C2D2E5"/></StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="2,3,0,20">
        <TextBlock x:Name="PageTitle" Text="Welcome to Moon" FontSize="29" FontWeight="Bold"/>
        <TextBlock x:Name="PageSubtitle" Text="Your Minecraft library, without the extra weight." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="OverviewHero" Background="#10243A" BorderBrush="#23425F" BorderThickness="1" CornerRadius="16" Padding="24" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="MOON LAUNCHER  /  WINDOWS" Foreground="#91D9FF" FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="A cleaner way to play." FontSize="30" FontWeight="Bold" Margin="0,10,0,6"/>
              <TextBlock Text="Manage Minecraft versions and local profiles, discover Modrinth modpacks, and keep your multiplayer shortcuts in one place." Foreground="#B9CBE0" FontSize="13" TextWrapping="Wrap" MaxWidth="690"/>
              <WrapPanel Margin="0,18,0,0"><Button Content="Browse modpacks" Click="Modpacks_Click" Padding="16,10" Margin="0,0,8,0"/><Button Content="Load versions" Click="LoadVersions_Click" Padding="16,10" Margin="0,0,8,0"/><Button Content="Create instance" Click="CreateInstance_Click" Padding="16,10"/></WrapPanel>
            </StackPanel>
          </Border>
          <UniformGrid x:Name="OverviewStats" Columns="2" Margin="0,0,0,16">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="VERSION CATALOG" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="VersionCount" Text="Not loaded" FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="8,0,0,0">
              <StackPanel><TextBlock Text="LOCAL INSTANCES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InstanceCount" Text="0 instances" FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
            </Border>
          </UniformGrid>
          <Border Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Workspace" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><ListBox x:Name="VersionsList" Visibility="Collapsed" Margin="0,12,0,0" MaxHeight="250" Background="#081321" Foreground="{StaticResource TextBrush}" BorderThickness="0"/></StackPanel>
          </Border>
          <Border x:Name="ModpacksPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Discover Modrinth modpacks" FontSize="19" FontWeight="Bold"/><TextBlock Text="Search public Modrinth projects or import a .mrpack file. Full dependency and loader installation is still being ported." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/><Button Content="Import .mrpack file" Click="ImportModpack_Click" HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,12"/><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Search" Click="SearchModpacks_Click" Padding="14,8" Margin="8,0,0,0"/><TextBox x:Name="ModpackQuery" Padding="10" FontSize="13" Text="performance"/></DockPanel><ListBox x:Name="ModpackResults" MouseDoubleClick="OpenSelectedModpack_Click" Background="#081321" Foreground="{StaticResource TextBrush}" BorderBrush="#243A54" MinHeight="200" MaxHeight="360"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#1B304A" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#9DB3CC" Margin="0,4,0,0"/><TextBlock Text="{Binding Footer}" Foreground="#76CFFF" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
          </Border>
          <Border x:Name="ServersPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Server shortcuts" FontSize="19" FontWeight="Bold"/><TextBlock Text="Save server addresses locally for quick reference." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ServerName" Grid.Column="0" Padding="10" Margin="0,0,8,0" ToolTip="Server name"/><TextBox x:Name="ServerAddress" Grid.Column="1" Padding="10" Margin="0,0,8,0" ToolTip="Server address (host:port)"/><Button Grid.Column="2" Content="Add server" Click="AddServer_Click" Padding="12,8"/></Grid><ListBox x:Name="ServerList" Margin="0,12,0,0" Background="#081321" Foreground="{StaticResource TextBrush}" BorderBrush="#243A54" MinHeight="160" MaxHeight="300"/></StackPanel>
          </Border>
          <Border x:Name="ModsPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Instance mods" FontSize="19" FontWeight="Bold"/><TextBlock Text="Choose an instance folder to inspect or manage its mods. Full mod-loader and modpack installation support still needs porting." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><Button Content="Open Moon data folder" Click="OpenDataFolder_Click" HorizontalAlignment="Left" Padding="14,9" Margin="0,14,0,0"/></StackPanel>
          </Border>
          <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#1B304A" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Settings" FontSize="19" FontWeight="Bold"/><TextBlock Text="Launcher data directory" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/><TextBlock x:Name="DataDirectory" TextWrapping="Wrap"/><TextBlock Text="This native build is being brought back to feature parity. Microsoft authentication and the full game install/launch pipeline have not yet been ported." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="MOON LAUNCHER  •  NATIVE WINDOWS  •  x64" Foreground="#6D89AA" FontSize="9" Margin="2,16,0,0"/>
    </Grid>
  </Grid>
</Window>