<Window x:Class="MoonLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Moon Launcher" Height="860" Width="1440" MinHeight="720" MinWidth="1120" Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#09071B" BorderBrush="#29204D" BorderThickness="0,0,0,1" MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
      <Grid Margin="16,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="☾" Foreground="#C4A0FF" FontSize="20" Margin="0,0,9,0"/><TextBlock Text="MOON LAUNCHER" FontSize="11" FontWeight="Bold" Foreground="#F5F0FF" VerticalAlignment="Center"/><TextBlock Text="  /  WINDOWS" FontSize="9" Foreground="#8E83B8" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="—" Width="42" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#B7B0E8" Click="MinimizeWindow_Click" ToolTip="Minimize"/>
          <Button Content="×" Width="42" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#B7B0E8" Click="CloseWindow_Click" ToolTip="Close"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,20,22,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#100B2A" BorderBrush="#35205E" BorderThickness="1" CornerRadius="18" Padding="14" Margin="0,0,20,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="2,5,0,4"><TextBlock Text="☾" FontSize="28" Foreground="#C9A2FF" Margin="0,0,9,0"/><TextBlock Text="MOON" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="MINECRAFT, YOUR WAY" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="3,0,0,28"/>
          <TextBlock Text="YOUR SPACE" Foreground="#9488C6" FontSize="10" FontWeight="Bold" Margin="4,0,0,9"/>
          <Button Content="⌂   Overview" Click="Overview_Click" Style="{StaticResource NavButton}"/>
          <Button Content="◈   Minecraft versions" Click="Versions_Click" Style="{StaticResource NavButton}"/>
          <Button Content="▦   Instances" Click="Instances_Click" Style="{StaticResource NavButton}"/>
          <Button Content="▧   Modpacks" Click="Modpacks_Click" Style="{StaticResource NavButton}"/>
          <Button Content="⌘   Mods" Click="Mods_Click" Style="{StaticResource NavButton}"/>
          <Button Content="◎   Servers" Click="Servers_Click" Style="{StaticResource NavButton}"/>
          <Button Content="⚙   Settings" Click="Settings_Click" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#1B1240" BorderBrush="#3A246B" BorderThickness="1" CornerRadius="14" Padding="13" Margin="0,20,0,0">
          <StackPanel><TextBlock Text="MICROSOFT ACCOUNT" FontSize="9" FontWeight="Bold" Foreground="#C4A0FF"/><TextBlock x:Name="AccountStatusText" Text="Not signed in" TextWrapping="Wrap" Margin="0,7,0,10" FontSize="11" Foreground="#DED5FF"/><Button x:Name="MicrosoftSignInButton" Content="Sign in with Microsoft" Click="MicrosoftSignIn_Click" Padding="10,8" FontSize="11"/><Button x:Name="MicrosoftSignOutButton" Content="Sign out" Click="MicrosoftSignOut_Click" Padding="10,7" Margin="0,6,0,0" FontSize="10" Visibility="Collapsed"/></StackPanel>
        </Border>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="2,3,0,20">
        <TextBlock x:Name="PageTitle" Text="Welcome to Moon" FontSize="30" FontWeight="SemiBold" Foreground="#F2F7FF"/>
        <TextBlock x:Name="PageSubtitle" Text="Your Minecraft library, without the extra weight." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="OverviewHero" Background="#171035" BorderBrush="#3B286B" BorderThickness="1" CornerRadius="16" Padding="30" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="✦  MOON LAUNCHER     /     WINDOWS EDITION" Foreground="#D0A2FF" FontSize="10" FontWeight="Bold"/>
              <TextBlock Text="A better home for&#10;your Minecraft worlds." FontSize="34" FontWeight="Bold" Margin="0,12,0,8" Foreground="#FCF8FF"/>
              <TextBlock Text="Manage your Minecraft versions, organize local profiles, discover community modpacks, and keep your favorite servers close at hand." Foreground="#D5C9F4" FontSize="13" LineHeight="21" TextWrapping="Wrap" MaxWidth="650"/>
              <WrapPanel Margin="0,18,0,0"><Button Content="Browse modpacks" Click="Modpacks_Click" Padding="16,10" Margin="0,0,8,0"/><Button Content="Load versions" Click="LoadVersions_Click" Padding="16,10" Margin="0,0,8,0"/><Button Content="Create instance" Click="CreateInstance_Click" Padding="16,10"/></WrapPanel>
            </StackPanel>
          </Border>
          <UniformGrid x:Name="OverviewStats" Columns="2" Margin="0,0,0,16">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#322052" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,8,0">
              <StackPanel><TextBlock Text="VERSION CATALOG" Foreground="#A89BCF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="VersionCount" Text="Not loaded" FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#322052" BorderThickness="1" CornerRadius="16" Padding="20" Margin="8,0,0,0">
              <StackPanel><TextBlock Text="LOCAL INSTANCES" Foreground="#A89BCF" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="InstanceCount" Text="0 instances" FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
            </Border>
          </UniformGrid>
          <Border x:Name="WorkspacePanel" Background="{StaticResource PanelBrush}" BorderBrush="#203954" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Workspace" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><ListBox x:Name="VersionsList" Visibility="Collapsed" Margin="0,12,0,0" MaxHeight="250" Background="#0C0820" Foreground="{StaticResource TextBrush}" BorderThickness="0"/></StackPanel>
          </Border>
          <Border x:Name="ModpacksPanel" Visibility="Collapsed" Background="#0D1726" BorderBrush="#253A53" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
            <StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MODRINTH CATALOG" FontSize="10" FontWeight="Bold" Foreground="#C4A0FF"/><TextBlock Text="Discover modpacks" FontSize="24" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock Text="Find a pack for your next playthrough." Foreground="{StaticResource MutedBrush}" FontSize="13"/></StackPanel><Button Grid.Column="1" Content="Import .mrpack" Click="ImportModpack_Click" Padding="15,10" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Search packs" Click="SearchModpacks_Click" Padding="16,10" Margin="10,0,0,0"/><TextBox x:Name="ModpackQuery" Padding="12" FontSize="13" Text="performance" ToolTip="Search Modrinth modpacks"/></DockPanel><TextBlock Text="COMMUNITY PACKS" FontSize="10" FontWeight="Bold" Foreground="#7D96B3" Margin="0,0,0,8"/><ListBox x:Name="ModpackResults" MouseDoubleClick="OpenSelectedModpack_Click" Background="#091321" Foreground="{StaticResource TextBrush}" BorderBrush="#243A54" MinHeight="300" MaxHeight="480"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" BorderBrush="#322052" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#9DB3CC" Margin="0,4,0,0"/><TextBlock Text="{Binding Footer}" Foreground="#76CFFF" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
          </Border>
          <Border x:Name="ServersPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#322052" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Server shortcuts" FontSize="19" FontWeight="Bold"/><TextBlock Text="Save server addresses locally for quick reference." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ServerName" Grid.Column="0" Padding="10" Margin="0,0,8,0" ToolTip="Server name"/><TextBox x:Name="ServerAddress" Grid.Column="1" Padding="10" Margin="0,0,8,0" ToolTip="Server address (host:port)"/><Button Grid.Column="2" Content="Add server" Click="AddServer_Click" Padding="12,8"/></Grid><ListBox x:Name="ServerList" Margin="0,12,0,0" Background="#0C0820" Foreground="{StaticResource TextBrush}" BorderBrush="#243A54" MinHeight="160" MaxHeight="300"/></StackPanel>
          </Border>
          <Border x:Name="ModsPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#322052" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="MODRINTH MOD CATALOG" FontSize="10" FontWeight="Bold" Foreground="#C4A0FF"/><TextBlock Text="Mods" FontSize="24" FontWeight="Bold" Margin="0,7,0,4"/><TextBlock Text="Search Modrinth and install compatible mods into a Minecraft mods folder." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Choose mods folder" Click="ChooseModsFolder_Click" Padding="13,9" Margin="8,0,0,0"/><TextBlock x:Name="ModsFolderText" Text="Choose an existing mods folder first" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#C4A0FF"/></DockPanel><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ModQuery" Grid.Column="0" Text="sodium" ToolTip="Search mods" Margin="0,0,8,0"/><TextBox x:Name="ModGameVersion" Grid.Column="1" Text="1.21.6" ToolTip="Minecraft version" Margin="0,0,8,0"/><ComboBox x:Name="ModLoaderChoice" Grid.Column="2" SelectedIndex="0" Margin="0,0,8,0" Padding="8"><ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Quilt"/></ComboBox><Button Grid.Column="3" Content="Search" Click="SearchMods_Click" Padding="14,9"/></Grid><ListBox x:Name="ModResults" Background="#0C0820" Foreground="{StaticResource TextBrush}" BorderBrush="#322052" MinHeight="280" MaxHeight="440" SelectionChanged="ModResults_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="#322052" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/><TextBlock Text="{Binding Footer}" Foreground="#C4A0FF" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,12,0,0"><Button Content="Install selected mod" Click="InstallSelectedMod_Click" Padding="15,10"/><TextBlock x:Name="ModInstallStatus" Text="Select a result to install." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="600"/></WrapPanel></StackPanel>
          </Border>
          <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="#322052" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="Settings" FontSize="19" FontWeight="Bold"/><TextBlock Text="Launcher data directory" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/><TextBlock x:Name="DataDirectory" TextWrapping="Wrap"/><TextBlock Text="This native build is being brought back to feature parity. Microsoft authentication and the full game install/launch pipeline have not yet been ported." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="MOON LAUNCHER   /   NATIVE WINDOWS   /   X64" Foreground="#8C7BB9" FontSize="9" Margin="2,14,0,0"/>
    </Grid>
    </Grid>
  </Grid>
</Window>