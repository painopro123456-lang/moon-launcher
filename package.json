{
  "name": "moon-launcher",
  "productName": "Moon Launcher",
  "version": "0.1.2",
  "private": true,
  "description": "A Windows Minecraft launcher for managing versions, instances, and modpacks.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2",
    "minecraft-launcher-core": "3.18.2"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.moon.launcher",
    "productName": "Moon Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Moon-Launcher-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moon Launcher",
      "compression": "maximum"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "painopro123456-lang",
        "repo": "moon-launcher"
      }
    ]
  }
}
