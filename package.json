{
  "name": "moon-launcher",
  "productName": "Moon Launcher",
  "version": "0.2.4",
  "private": true,
  "description": "A Windows Minecraft launcher for managing versions, instances, and modpacks.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "release:win": "electron-builder --win nsis portable --x64 --publish always"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.6.2",
    "minecraft-launcher-core": "^3.18.2"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.moonlauncher.app",
    "productName": "Moon Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "native/moon-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "Moon-Launcher-Portable-${version}.${ext}"
    },
    "artifactName": "Moon-Launcher-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "painopro123456-lang",
        "repo": "moon-launcher",
        "releaseType": "release"
      }
    ]
  }
}
