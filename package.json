{
  "name": "moon-launcher",
  "productName": "Moon Launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows Minecraft launcher for managing versions, instances, and modpacks.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@xmcl/core": "^2.16.2",
    "@xmcl/installer": "^6.3.6",
    "@xmcl/modrinth": "^2.5.3",
    "@xmcl/user": "^4.4.2",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.moon.launcher",
    "productName": "Moon Launcher",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Moon-Launcher-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moon Launcher"
    }
  }
}